{
    "name": "boxpos/material-suppliers",
    "description": "Material Suppliers Management Package for BoxPos - Supplier relationship management",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "BoxPos Team",
            "email": "dev@boxpos.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Packages\\MaterialSuppliers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packages\\MaterialSuppliers\\Tests\\": "src/Tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Packages\\MaterialSuppliers\\MaterialSuppliersServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
